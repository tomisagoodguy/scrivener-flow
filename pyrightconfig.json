{
  "pythonVersion": "3.13",
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "ETF",
    "scripts",
    "tests"
  ],
  "extraPaths": [
    "."
  ],
  "executionEnvironments": [
    {
      "root": "."
    }
  ],
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/*.pyc",
    "**/.*",
    ".next",
    ".venv",
    "dist",
    "build",
    "src"
  ]
}
