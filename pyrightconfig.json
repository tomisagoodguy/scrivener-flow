{
    "include": [
        "ETF",
        "scripts",
        "tests"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        ".venv"
    ],
    "venvPath": ".",
    "venv": ".venv",
    "executionEnvironments": [
        {
            "root": "."
        }
    ],
    "extraPaths": [
        "."
    ],
    "pythonVersion": "3.13",
    "typeCheckingMode": "basic",
    "reportMissingImports": true,
    "reportMissingTypeStubs": false
}
